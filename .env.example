# 환경변수 예시 파일 (기획안 §11)
# 이 파일은 변수명과 빈 값만 담는다. 실제 값은 .env 에 적고 .env 는 추적하지 않는다.
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.

# ── 정책 자료 수집 (B 담당) ──

# 공공데이터포털 등 정책 자료 API 인증키. 사용하는 출처가 확정되면 변수명을 맞춘다.
POLICY_API_KEY=

# 출처별 요청 간 최소 대기 시간(초). 호출 제한을 지키기 위한 값.
POLICY_REQUEST_DELAY_SEC=1

# 한 번 실행에서 출처당 가져올 최대 문서 수. 과도한 요청을 막는 상한.
POLICY_MAX_DOCS_PER_SOURCE=100

# ── 뉴스 자료 수집 (A 담당) ──
# A가 출처를 확정한 뒤 필요한 변수를 추가한다.
NEWS_API_KEY=

# ── 공통 ──

# 수집·분석 결과를 저장할 디렉터리. 비워 두면 data/processed 를 쓴다.
DATA_DIR=

# 실행 로그 수준. debug / info / warning / error
LOG_LEVEL=info
